{
  "name": "2d-coop-survival",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22 <23",
    "pnpm": "10.33.2"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "eslint . --fix --fix-type layout --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:quality": "node tools/quality/japanese-comment-rule.test.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test:quality"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
